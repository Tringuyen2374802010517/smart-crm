FROM node:22-alpine AS frontend-build

WORKDIR /frontend
COPY src/frontend/package.json src/frontend/package-lock.json ./
RUN npm ci
COPY src/frontend/ ./
RUN npm run build

FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx gosu \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system appuser \
    && useradd --system --gid appuser \
       --home-dir /app --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/data \
    && ln -s /app/data/smartcrm.db /app/smartcrm.db

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY src /app/src
COPY scripts /app/scripts
COPY docs/schema.sql /app/docs/schema.sql
COPY docs/seed.sql /app/docs/seed.sql

COPY --from=frontend-build /frontend/dist /usr/share/nginx/html
COPY nginx.render.conf /etc/nginx/conf.d/default.conf

EXPOSE 10000

CMD ["bash", "/app/scripts/render-start.sh"]
